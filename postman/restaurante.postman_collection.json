          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellidos\": \"Perez\",\n  \"telefono\": \"987654321\",\n  \"direccion\": \"Lima\",\n  \"estado\": \"A\"\n}",
          "options": {
